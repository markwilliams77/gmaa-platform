generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role
  vendorStatus VendorUserStatus @default(DOCUMENTS_PENDING)
  vendor    Vendor?
  messages  Message[]
  createdAt DateTime  @default(now())
}

enum Role {
  ADMIN
  VENDOR
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LeadStatus {
  NEW
  UNDER_REVIEW
  ASSIGNED
  BROADCASTED
  ACKNOWLEDGED
  DOCUMENTS_REQUESTED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum WebsiteProfileStatus {
  DRAFT
  READY_FOR_REVIEW
  PUBLISHED
  ARCHIVED
}

model Vendor {
  id            String       @id @default(uuid())
  vendorNumber  String?      @unique
  userId        String       @unique
  companyName   String
  isMock        Boolean  @default(false)
  image         String?
  rating        Float?
  mainCategory  String?
  subCategory   String?
  specialty     String?
  country String?
  state   String?
  city    String?
  staffCount    String?

  user              User               @relation(fields: [userId], references: [id])
  bids              Bid[]
  conversations     SupportThread[]
  roundParticipants RoundParticipant[]
  documents VendorDocument[]
  onboarding VendorOnboarding?
  websiteProfile WebsiteProfile?
  websiteServices WebsiteService[]
  websiteGallery        WebsiteGallery[]
  websiteAccreditations WebsiteAccreditation[]
  websiteTestimonials   WebsiteTestimonial[]
  verificationStatus VendorVerificationStatus @default(DRAFT)
  
  verificationSubmittedAt DateTime?
  verificationReviewedAt DateTime?
  verificationReviewedBy String?
  verificationRemarks String?
}

model WebsiteProfile {
  id                 String   @id @default(uuid())

  vendorId           String   @unique
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status             WebsiteProfileStatus @default(DRAFT)
  featured           Boolean @default(false)
  displayOrder       Int @default(0)

  profileHeadline    String?
  profileTemplate    String?
  description        String? @db.Text

  coverImage         String?
  brochureUrl        String?

  highlights         Json?

  hasConcierge       Boolean @default(false)

  seoTitle           String?
  seoDescription     String? @db.Text

  publishedAt        DateTime?
  publishedById      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WebsiteService {
  id        String @id @default(uuid())

  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteGallery {
  id        String @id @default(uuid())

  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  imageUrl  String
  caption   String?
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteAccreditation {
  id        String @id @default(uuid())

  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  title     String
  imageUrl  String?
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteTestimonial {
  id        String @id @default(uuid())

  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  patientName String
  country     String?
  testimonial String @db.Text
  imageUrl    String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorOnboarding {
  id                String                 @id @default(uuid())
  orgName           String
  address           String
  country String?
  state   String?
  city    String?
  email             String                 @unique
  contactPerson     String
  contactNumber     String
  mainCategory      String?
  subCategory       String?
  specialties       String[]               @default([])
  plan              String
  documents         Json?                  @default("{}")
  paymentOrderId    String?
  paymentStatus     String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  status            VendorOnboardingStatus @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  consentAcceptedAt DateTime?
  consentPolicyVersion String?

  vendorId String? @unique
  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorLoginInfo VendorLoginInfo?
}

model VendorLoginInfo {
  id                 String   @id @default(uuid())
  vendorOnboardingId String   @unique
  username           String   @unique
  email              String?
  passwordHash       String
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vendorOnboarding VendorOnboarding @relation(fields: [vendorOnboardingId], references: [id])
}

model VendorDocument {
  id             String @id @default(uuid())

  vendorId       String
  vendor         Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  documentType   VendorDocumentType

  fileName       String
  s3Key          String
  fileUrl        String
  fileSize Int?

  uploadedById   String?
  uploadedByName String?
  uploadedByRole Role?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum VendorOnboardingStatus {
  DRAFT
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  CANCELLED
}

enum VendorDocumentType {
  COMPANY_REGISTRATION
  TAX_REGISTRATION
  SIGNATORY_ID
  ADDRESS_PROOF
  BANK_VERIFICATION

  COMPANY_LOGO
  BROCHURE
  GALLERY_IMAGE
  CERTIFICATE
  CONTRACT
  OTHER
}

enum VendorVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VendorUserStatus {
  DOCUMENTS_PENDING
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum TenderRoundStatus {
  OPEN
  CLOSED
}

enum TenderStatus {
  DRAFT
  BROADCASTED
  CLOSED
  AWARDED
}

enum BidStatus {
  SUBMITTED
  SHORTLISTED
  REJECTED
  AWARDED
}

enum LeadRoutingType {
  DIRECT
  TENDER
}

model Tender {
  id String @id @default(uuid())
  tenderNumber String @unique

  leadId String?

  title       String
  description String

  mainCategory String?

  createdBy String

  status TenderStatus @default(DRAFT)

  deadline DateTime?

  awardedVendorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rounds        TenderRound[]
  conversations SupportThread[]

  bids Bid[]
}

model Bid {
  id String @id @default(uuid())

  tenderId String

  roundId String

  vendorId String

  amount Float

  proposal String?

  status BidStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tender Tender @relation(fields: [tenderId], references: [id])

  round TenderRound @relation(fields: [roundId], references: [id])

  vendor Vendor @relation(fields: [vendorId], references: [id])
}

model TenderRound {
  id String @id @default(uuid())

  tenderId String

  roundNumber Int

  status TenderRoundStatus @default(OPEN)

  createdAt DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id])

  bids         Bid[]
  participants RoundParticipant[]
}

model RoundParticipant {
  id String @id @default(uuid())

  roundId  String
  vendorId String

  createdAt DateTime @default(now())

  round  TenderRound @relation(fields: [roundId], references: [id])
  vendor Vendor      @relation(fields: [vendorId], references: [id])

  @@unique([roundId, vendorId])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model SupportThread {
  id String @id @default(uuid())

  tenderId String?
  vendorId String?

  createdBy String

  status ConversationStatus @default(OPEN)

  messages Message[]

  documents WorkspaceDocument[]

  tender Tender? @relation(fields: [tenderId], references: [id])

  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@unique([tenderId, vendorId])
}

model Message {
  id String @id @default(uuid())

  threadId String

  senderId String

  content String

  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id])

  sender User @relation(fields: [senderId], references: [id])
}

enum LeadSource {
  HOMEPAGE_ENQUIRY
  VENDOR_ENQUIRY
  DIRECT_CALL
  MANUAL_ADMIN
}

enum LeadType {
  DIRECT
  VENDOR_ENQUIRY
  TENDER
}

model Lead {
  id String @id @default(uuid())

  leadNumber String? @unique

  name  String
  email String

  patientPhone String?

  title       String?
  description String?

  serviceCategory String?

  country String?
  city    String?

  priority LeadPriority @default(MEDIUM)

  status LeadStatus @default(NEW)

  assignedTo       String?
  assignedToUserId String?

  routingType LeadRoutingType @default(DIRECT)

  selectedVendorId String?

  source LeadSource @default(HOMEPAGE_ENQUIRY)

  leadType LeadType @default(DIRECT)

  vendorId String?

  vendorName String?

  clientId String?

  client Client? @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes LeadNote[]

  documents  LeadDocument[]
  activities LeadActivity[]
  folders    LeadFolder[]
}

enum DocumentCategory {
  CLIENT_DOCUMENT
  VENDOR_DOCUMENT
  QUOTATION
  INVOICE
  CONTRACT
  AGREEMENT
  LICENSE
  PRESCRIPTION
  TREATMENT_PLAN
  DIAGNOSTIC_REPORT
  OTHER
}

enum DocumentVisibility {
  ADMIN_ONLY
  CLIENT_ONLY
  VENDOR_ONLY
  CLIENT_AND_ADMIN
  VENDOR_AND_ADMIN
  SHARED
}

model LeadDocument {
  id String @id @default(uuid())

  leadId String

  fileName String
  fileUrl  String

  s3Key String

  category    DocumentCategory?
  subCategory String?

  documentType String?

  visibility DocumentVisibility @default(SHARED)

  uploadedByRole String?

  uploadedById String?

  uploadedByName String?

  folderId String?

  createdAt DateTime @default(now())

  lead   Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  folder LeadFolder? @relation(fields: [folderId], references: [id])

  @@index([leadId])
  @@index([folderId])
}

model WorkspaceDocument {
  id String @id @default(uuid())

  threadId String

  fileName String
  fileUrl  String

  s3Key String

  documentType String?

  uploadedByRole String?

  uploadedById String?

  uploadedByName String?

  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model LeadFolder {
  id String @id @default(uuid())

  leadId String

  name String

  createdBy String?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  documents LeadDocument[]

  @@index([leadId])
}

model LeadActivity {
  id String @id @default(uuid())

  leadId String

  activity    String
  description String?

  createdBy String?

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadNote {
  id String @id @default(uuid())

  leadId    String
  note      String
  createdBy String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

enum ConsultationStatus {
  NEW
  CONTACTED
  QUALIFIED
  REJECTED
  CONVERTED
}

model ConsultationNote {
  id String @id @default(uuid())

  consultationId String

  note String

  createdBy String

  createdAt DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id])
}

model Consultation {
  id String @id @default(uuid())

  name  String
  email String
  phone String?

  category String?

  service String?
  country String?
  state   String?
  city    String?

  vendorId   String?
  vendorName String?

  details Json?

  status ConsultationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  consentAcceptedAt DateTime?
  consentPolicyVersion String?

  notes ConsultationNote[]
}

model OtpLead {
  id             String    @id @default(uuid())
  phone          String    @unique
  email          String?   @unique
  otpSendCount   Int       @default(0)
  otpCode        String?
  otpExpiresAt   DateTime?
  firstOtpSentAt DateTime  @default(now())
  lastOtpSentAt  DateTime  @default(now())
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Client {
  id String @id @default(uuid())

  name String

  phone String @unique

  email String?

  country String?
  city    String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}
